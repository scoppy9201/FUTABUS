{
    "name": "futebus/ticketmanagement",
    "description": "TicketManagement module for FUTEBUS.",
    "type": "library",
    "version": "1.0.0",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "futebus/core": "*",
        "futebus/payment": "*",
        "futebus/bookingmanagement": "*",
        "futebus/cancellation": "*",
        "futebus/seatmanagement": "*",
        "futebus/tripmanagement": "*"
    },
    "autoload": {
        "psr-4": {
            "FuteBus\\TicketManagement\\": "src/"
        }
    },
    "extra": {
