{
    "name": "futebus/reporting",
    "description": "Reporting module for FUTEBUS.",
    "type": "library",
    "version": "1.0.0",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "futebus/busmanagement": "*",
        "futebus/payment": "*",
        "futebus/routemanagement": "*",
        "futebus/ticketmanagement": "*",
        "futebus/tripmanagement": "*"
    },
    "autoload": {
        "psr-4": {
            "FuteBus\\Reporting\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "FuteBus\\Reporting\\Providers\\ReportingServiceProvider"
            ]
        }
    }
}
