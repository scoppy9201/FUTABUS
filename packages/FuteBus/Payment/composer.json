{
    "name": "futebus/payment",
    "description": "Payment module for FUTEBUS.",
    "type": "library",
    "version": "1.0.0",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "futebus/auth": "*",
        "futebus/bookingmanagement": "*",
        "futebus/cancellation": "*",
        "futebus/core": "*",
        "futebus/dashboard": "*",
        "futebus/profile": "*",
        "futebus/staffdashboard": "*",
        "futebus/tripsearch": "*",
        "futebus/buscompanymanagement": "*",
        "futebus/customermanagement": "*",
        "futebus/seatmanagement": "*",
        "futebus/ticketmanagement": "*",
        "futebus/tripmanagement": "*"
    },
    "autoload": {
        "psr-4": {
            "FuteBus\\Payment\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "FuteBus\\Payment\\Providers\\PaymentServiceProvider"
            ]
        }
    }
}
