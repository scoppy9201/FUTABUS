{
    "name": "futebus/auth",
    "description": "Auth module for FUTEBUS.",
    "type": "library",
    "version": "1.0.0",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "futebus/bookingmanagement": "*",
        "futebus/buscompanymanagement": "*",
        "futebus/cancellation": "*",
        "futebus/customermanagement": "*",
        "futebus/payment": "*",
        "futebus/profile": "*",
        "futebus/rolepermission": "*",
        "futebus/staffcustomersupport": "*"
    },
    "autoload": {
        "psr-4": {
            "FuteBus\\Auth\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "FuteBus\\Auth\\Providers\\AuthServiceProvider"
            ]
        }
    }
}
