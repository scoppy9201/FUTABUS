{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "futabus/futabus",
    "type": "project",
    "description": "FUTABUS - Nền tảng đặt và quản lý vé xe khách trực tuyến tích hợp AI (Laravel 12 modular monolith).",
    "keywords": ["laravel", "bus", "ticket", "booking", "modular", "monolith"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "barryvdh/laravel-dompdf": "^3.1",
        "blade-ui-kit/blade-heroicons": "2.7",
        "futebus/aiassistant": "*",
        "futebus/auth": "*",
        "futebus/bookingmanagement": "*",
        "futebus/buscompanymanagement": "*",
        "futebus/busmanagement": "*",
        "futebus/cancellation": "*",
        "futebus/core": "*",
        "futebus/customermanagement": "*",
        "futebus/dashboard": "*",
        "futebus/notification": "*",
        "futebus/payment": "*",
        "futebus/profile": "*",
        "futebus/reporting": "*",
        "futebus/rolepermission": "*",
        "futebus/routemanagement": "*",
        "futebus/seatavailability": "*",
        "futebus/seatmanagement": "*",
        "futebus/systemsetting": "*",
        "futebus/ticketmanagement": "*",
        "futebus/tripmanagement": "*",
        "futebus/tripsearch": "*",
        "futebus/usermanagement": "*",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.3",
        "laravel/socialite": "^5.26",
        "laravel/tinker": "^2.10.1",
        "maatwebsite/excel": "^3.1",
        "phpoffice/phpspreadsheet": "^1.30",
        "simplesoftwareio/simple-qrcode": "^4.2"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.7",
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/Customer/BookingManagement",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "packages/Customer/Cancellation",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "packages/Customer/SeatAvailability",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "packages/Customer/TicketManagement",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "packages/Customer/TripSearch",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "packages/futebus/AiAssistant",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "packages/futebus/Auth",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "packages/futebus/BusCompanyManagement",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "packages/futebus/BusManagement",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "packages/futebus/Core",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "packages/futebus/CustomerManagement",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "packages/futebus/Dashboard",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "packages/futebus/Notification",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "packages/futebus/Payment",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "packages/futebus/Profile",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "packages/futebus/Reporting",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "packages/futebus/RolePermission",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "packages/futebus/RouteManagement",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "packages/futebus/SeatManagement",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "packages/futebus/SystemSetting",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "packages/futebus/TripManagement",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "packages/futebus/UserManagement",
            "options": { "symlink": true }
        }
    ],
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
