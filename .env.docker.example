# Monexa — Docker environment template.
#
# Copy this to `.env` on the target host (or for the docker-compose dev stack)
# and fill in real values. NEVER commit a filled-in .env. Secrets used by CI/CD
# are configured as GitHub Actions secrets — see docs/DEPLOYMENT.md.

# Application 
APP_NAME=Monexa
APP_ENV=production
# Generate once with: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Logging 
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Database (MySQL container: host = service name "mysql")
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=monexa
DB_USERNAME=monexa
DB_PASSWORD=change-me-strong
# Only used to initialise the MySQL container / for admin tasks.
DB_ROOT_PASSWORD=change-me-root-strong

# Redis (cache / session / queue) — host = service name "redis" 
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-strong

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Mail 
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=no-reply@your-domain.example
MAIL_FROM_NAME="${APP_NAME}"

# Google OAuth (laravel/socialite) 
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT=https://your-domain.example/auth/google/callback

# Gemini AI (app/Services/GeminiService.php) 
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Vite (build-time)
VITE_APP_NAME="${APP_NAME}"

# Docker deploy metadata (consumed by docker-compose.prod.yml / deploy.sh)
# These are normally exported by deploy.sh from the pushed image tags.
# APP_IMAGE=ghcr.io/OWNER/monexa-app:latest
# NGINX_IMAGE=ghcr.io/OWNER/monexa-nginx:latest
HTTP_PORT=80
