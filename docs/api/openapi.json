      }
    },
    "/api/v1/contact-messages": {
      "post": {
        "tags": [
          "Content"
        ],
        "operationId": "createContactMessage",
        "summary": "Submit a contact message",
        "description": "Public endpoint limited to five submissions per minute.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "department",
                  "name",
                  "email",
                  "phone",
                  "subject",
                  "message"
                ],
                "properties": {
                  "department": {
                    "type": "string",
                    "const": "futabus"
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 255
                  },
                  "phone": {
                    "type": "string"
                  },
                  "subject": {
                    "type": "string",
                    "maxLength": 255
                  },
                  "message": {
                    "type": "string",
                    "maxLength": 5000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Message saved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": [
                        "id"
                      ],
                      "properties": {
                        "id": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/api/v1/ticket-lookups": {
      "post": {
        "tags": [
          "Ticket lookup"
        ],
        "operationId": "lookupTicket",
        "summary": "Look up a ticket by phone and code",
        "description": "Rate-limited public lookup. Phone and code are supplied in the request body to avoid placing them in URLs or logs. Responses must not be cached.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "phone",
                  "ticket_code"
                ],
                "properties": {
                  "phone": {
                    "type": "string"
                  },
                  "ticket_code": {
                    "type": "string",
                    "maxLength": 100
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Matching booking and tickets",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "example": "no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": [
                        "booking",
                        "tickets",
                        "payment_status"
                      ],
                      "properties": {
                        "booking": {
                          "type": "object",
                          "additionalProperties": true
                        },
                        "tickets": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": true
                          }
                        },
                        "payment_status": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No matching booking or ticket"
          },
          "422": {
            "description": "Invalid phone or code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "SePayHmac": {
        "type": "apiKey",
        "in": "header",
        "name": "X-SePay-Signature",
        "description": "Requires X-SePay-Timestamp too. The signature covers the raw body and timestamp; a static key entered in Swagger UI cannot generate it."
      },
      "SePayApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Exact value: Apikey <configured webhook key>. Used only when API-key mode is configured."
      },
      "BearerToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Sanctum personal access token"
      }
    },
    "schemas": {
      "TripSearchResponse": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "outbound",
              "return"
            ],
            "properties": {
              "outbound": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/TripSummary"
                }
              },
              "return": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/TripSummary"
                }
              }
            }
          }
        }
      },
      "TripSummary": {
        "type": "object",
        "required": [
          "id",
          "departure_time",
          "arrival_time",
          "origin",
          "destination",
          "vehicle_type",
          "available_seats",
          "price"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "departure_time": {
            "type": "string",
            "description": "Departure time in the server time zone."
          },
          "arrival_time": {
            "type": "string",
            "description": "Arrival time in the server time zone."
          },
          "origin": {
            "type": "string"
          },
          "destination": {
            "type": "string"
          },
          "vehicle_type": {
            "type": "string"
          },
          "available_seats": {
            "type": "integer",
            "minimum": 0
          },
          "price": {
            "type": "integer",
            "minimum": 0,
            "description": "Vietnamese dong."
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          }
        }
      },
      "WebhookResponse": {
        "type": "object",
        "required": [
          "success"
        ],
        "properties": {
          "success": {
            "type": "boolean"
          }
        }
      },
      "SePayEvent": {
        "type": "object",
        "required": [
          "id",
          "transferType",
          "transferAmount",
          "accountNumber"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "description": "SePay transaction ID"
          },
          "transferType": {
            "type": "string",
            "enum": [
              "in",
              "out"
            ]
          },
          "transferAmount": {
            "type": "integer",
            "minimum": 0
          },
          "accountNumber": {
            "type": "string",
            "maxLength": 32
          },
          "code": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          },
          "content": {
            "type": "string",
            "description": "Transfer memo; may contain the FUTA payment code."
          }
        },
        "additionalProperties": true
      },
      "ValidationError": {
        "type": "object",
        "required": [
          "message",
          "errors"
        ],
        "properties": {
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "Account": {
        "type": "object",
        "required": [
          "id",
          "name",
          "email",
          "phone",
          "has_avatar"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string"
          },
          "gender": {
            "type": [
              "string",
              "null"
            ]
          },
          "date_of_birth": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "address": {
            "type": [
              "string",
              "null"
            ]
          },
          "occupation": {
            "type": [
              "string",
              "null"
            ]
          },
          "has_avatar": {
            "type": "boolean"
          }
        }
      },
      "BookingSummary": {
        "type": "object",
        "required": [
          "id",
          "booking_code",
          "seat_count",
          "total_amount",
          "status",
          "departure_time",
          "origin",
          "destination"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "booking_code": {
            "type": "string"
          },
          "seat_count": {
            "type": "integer"
          },
          "total_amount": {
            "type": "number"
          },
          "status": {
            "type": "string"
          },
          "payment_status": {
            "type": [
              "string",
              "null"
            ]
          },
          "departure_time": {
            "type": "string"
          },
          "origin": {
            "type": "string"
          },
          "destination": {
            "type": "string"
          },
          "can_contact_for_change": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
