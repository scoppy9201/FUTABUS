{
  "openapi": "3.1.1",
  "info": {
    "title": "FUTABUS HTTP API",
    "version": "1.0.0",
    "description": "Current public HTTP API. Booking and account pages use web routes and are not represented as REST endpoints. The SePay webhook is called by SePay, not by customers."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current FUTABUS host"
    }
  ],
  "tags": [
    {
      "name": "System"
    },
    {
      "name": "Trips"
    },
    {
      "name": "Payment webhooks"
    },
    {
      "name": "Content"
    },
    {
      "name": "Authentication"
    },
    {
      "name": "Account"
    },
    {
      "name": "Bookings"
    },
    {
      "name": "Ticket lookup"
    }
  ],
  "paths": {
    "/api/v1/trips": {
      "get": {
        "tags": [
          "Trips"
        ],
        "operationId": "listTrips",
        "summary": "Find available FUTA trips",
        "parameters": [
          {
            "name": "departure",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 120
            }
          },
          {
            "name": "destination",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 120
            }
          },
          {
            "name": "departure_date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "return_date",
            "in": "query",
            "description": "Required for a round trip.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "trip_type",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "one_way",
                "round_trip"
              ]
            }
          },
          {
            "name": "quantity",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Trips grouped by travel direction",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TripSearchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid search criteria",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "System"
        ],
        "operationId": "getHealth",
        "summary": "Check API availability",
        "responses": {
          "200": {
            "description": "API is available",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        }
      }
    },
    "/api/sepay/webhook": {
      "post": {
        "tags": [
          "Payment webhooks"
        ],
        "operationId": "receiveSePayWebhook",
        "summary": "Receive a SePay bank transfer event",
        "description": "SePay calls this endpoint. Authentication mode is selected by server configuration: HMAC-SHA256 or API key. A successful HTTP response acknowledges receipt; it does not guarantee a booking was issued. Duplicate and unmatched transactions are handled by payment processing. Do not send test payments to a production account.",
        "security": [
          {
            "SePayHmac": []
          },
          {
            "SePayApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "X-SePay-Timestamp",
            "in": "header",
            "description": "Unix timestamp in seconds, accepted within five minutes when HMAC mode is active.",
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{10,12}$"
            }
          },
          {
            "name": "X-SePay-Signature",
            "in": "header",
            "description": "HMAC-SHA256 of timestamp + '.' + raw request body, prefixed with sha256=, when HMAC mode is active.",
            "schema": {
              "type": "string",
              "pattern": "^sha256=[a-f0-9]{64}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SePayEvent"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Event accepted for processing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookResponse"
                },
                "example": {
                  "success": true
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookResponse"
                },
                "example": {
                  "success": false
                }
              }
            }
          },
          "422": {
            "description": "Event payload failed validation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "503": {
            "description": "Payment integration is not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookResponse"
                },
                "example": {
                  "success": false
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/news": {
      "get": {
        "tags": [
          "Content"
        ],
        "operationId": "listNews",
        "summary": "List news articles",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Invalid search filters"
          }
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 100
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 100
            }
          }
        ]
      }
    },
    "/api/v1/news/{slug}": {
      "get": {
        "tags": [
          "Content"
        ],
        "operationId": "getArticle",
        "summary": "Get an article",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Resource not found"
          }
        },
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/faq-categories": {
      "get": {
        "tags": [
          "Content"
        ],
        "operationId": "listFaqCategories",
        "summary": "List FAQ categories",
        "responses": {
